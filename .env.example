# Salin file ini ke .env lalu isi kunci Anda.

GEMINI_KEY=
GROQ_KEY=
AQUA_KEY=
LOADER_KEY=
TOPMEDIA_KEY=
ANABOT_KEY=
MIFTAH_KEY=
CUKI_KEY=
LOL_KEY=
NEOXR_KEY=
THERESAV_KEY=
PITUCODE_KEY=
TG_TOKEN=
WEB_API_BASE=
KYZZ_KEY=
VAMX_KEY=
VXAPI_KEY=

# ---- Dashboard Auto Pengumuman (Hybrid WhatsApp + Web) ----
# Wajib: password admin minimal 8 karakter. Jangan pakai password yang sama dengan WA/VPS.
DASHBOARD_PASSWORD=
# Port HTTP di VPS. Bot + dashboard satu proses, jangan jalankan port ini di proses lain.
DASHBOARD_PORT=3000
DASHBOARD_HOST=0.0.0.0
# URL publik dashboard (dipakai .auto-pengumuman bot). Contoh: https://dashboard.example.com
DASHBOARD_PUBLIC_URL=
# Origin frontend Vercel untuk proteksi CSRF. Contoh: https://nama-app.vercel.app
DASHBOARD_ALLOWED_ORIGIN=
# Aktifkan hanya saat Vercel mem-proxy API ke VPS: none + Secure ( HTTPS ).
DASHBOARD_COOKIE_SAME_SITE=lax
DASHBOARD_COOKIE_SECURE=0
# Rahasia session tambahan (opsional, disarankan). Kosong = dibuat otomatis di database/.
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_HOURS=8
DASHBOARD_UPLOAD_MAX_MB=5
# Set 0 untuk mematikan dashboard; set 1 untuk perawatan (dashboard saja, WA tidak jalan).
DASHBOARD_ENABLED=1
SKIP_WHATSAPP=0
# ---- Deploy frontend ke Vercel (di project Vercel, bukan di .env bot) ----
# BACKEND_URL=https://dashboard.example.com

